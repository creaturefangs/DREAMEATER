  characterName: The Masked One
  characterPortrait: {fileID: -114668589741394927, guid: 7ea11d4e117c4e045813f4e19e3e48dd, type: 3}
  dialogueSprites: []
  dialogueLines:
  - 'Thou art finally hither, your prophetic quest. '
  - 'Chaos has opened her doors to you. You have limited time here, use it wisely. '
  - 'The configuration will fall soon enough. '
  - 'Heed my warning, the eyes of red shall burn thee. '
  - 'Eyes of blue will only help you. Follow the stars to the place where you belong. '
  - 'Take this key. '
  - "We shall meet again\u2026 Starlight."
  dialogueSFX: {fileID: 8300000, guid: cfb35284149d3c9418b49ad8474d44e8, type: 3}
